public class Solution {
    public int numDecodings(String s) {
        // Edge case: If the string is empty or starts with '0', there are no valid decodings
        if (s == null || s.length() == 0 || s.charAt(0) == '0') {
            return 0;
        }

        // dp[i] will store the number of ways to decode the substring s[0..i-1]
        int n = s.length();
        int[] dp = new int[n + 1];

        // Base case: There's one way to decode an empty string
        dp[0] = 1;

        // Base case: There's one way to decode a string of length 1, as long as it's not '0'
        dp[1] = s.charAt(0) == '0' ? 0 : 1;

        // Fill the dp array for substrings of length >= 2
        for (int i = 2; i <= n; i++) {
            // Check if single character s[i-1] is a valid decode (i.e., not '0')
            if (s.charAt(i - 1) != '0') {
                dp[i] += dp[i - 1];
            }

            // Check if the last two characters form a valid decode (between 10 and 26)
            int twoDigit = Integer.parseInt(s.substring(i - 2, i));
            if (twoDigit >= 10 && twoDigit <= 26) {
                dp[i] += dp[i - 2];
            }
        }

        // The answer is the number of ways to decode the entire string
        return dp[n];
    }
}
